{
  "name": "petarzarkov-portfolio",
  "version": "1.0.1",
  "description": "Portfolio made with Vite, React, TypeScript",
  "keywords": [
    "petar",
    "portfolio",
    "react",
    "typescript",
    "vite",
    "zarkov"
  ],
  "homepage": "https://petarzarkov.com",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/portfolio"
  },
  "type": "module",
  "scripts": {
    "prepare": "bun scripts/install-hooks.ts",
    "start": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint --max-warnings 0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test src scripts",
    "test:cov": "bun test src scripts --coverage",
    "test:browser": "cd browser && bun test --timeout 60000",
    "shots": "bun run build && bun run test:browser",
    "ci": "bun scripts/ci.ts"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^2.10.9",
    "@emailjs/browser": "^4.4.1",
    "formik": "^2.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@stagelint/stagelint": "0.1.4",
    "@types/bun": "1.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
